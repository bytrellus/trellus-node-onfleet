{
	"compilerOptions": {
		"target": "es2020",
		"module": "node16",
		"moduleResolution": "node16",
		"esModuleInterop": true,
		"outDir": "./dist",
		"strict": true,
		"types": ["node"],
		"resolveJsonModule": true,
		"declaration": true,
		"allowSyntheticDefaultImports": true
	},
	"include": ["lib/**/*", "test/**/*"],
	"ts-node": {
		"esm": true,
		"transpileOnly": true,
		"compilerOptions": {
			"module": "ESNext"
		}
	}
}
