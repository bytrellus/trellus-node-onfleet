{
	"compilerOptions": {
		"target": "es2020",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"esModuleInterop": true,
		"outDir": "./dist",
		"rootDir": "./lib",
		"strict": true,
		"types": ["node"],
		"resolveJsonModule": true,
		"declaration": true,
		"allowSyntheticDefaultImports": true,
		"sourceMap": true,
		"stripInternal": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["lib/*"]
		}
	},
	"include": ["lib/**/*"],
	"exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"],
	"ts-node": {
		"esm": true,
		"transpileOnly": true,
		"compilerOptions": {
			"module": "NodeNext"
		}
	}
}
