{
	"name": "trellus-node-onfleet",
	"version": "1.0.13",
	"description": "Trellus Fork of Onfleet's Node.js API Wrapper Package",
	"main": "./dist/cjs/index.js",
	"module": "./dist/esm/index.js",
	"types": "./dist/types/index.d.ts",
	"type": "module",
	"scripts": {
		"build": "npm run build:esm && npm run build:cjs && npm run create-package-files",
		"build:esm": "tsc --project tsconfig.esm.json",
		"build:cjs": "tsc --project tsconfig.cjs.json",
		"create-package-files": "node scripts/create-package-files.js",
		"lint": "eslint 'lib/**/*.ts'",
		"test": "vitest run",
		"prepare": "npm run build"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/bytrellus/trellus-node-onfleet.git"
	},
	"keywords": [
		"node-onfleet"
	],
	"author": "Justin D'Ottavio",
	"contributors": [
		"James Li",
		"Julián Pérez",
		"Santiago Botero"
	],
	"license": "MIT",
	"homepage": "https://onfleet.com/",
	"files": [
		"dist"
	],
	"dependencies": {
		"bottleneck": "^2.19.5",
		"node-fetch": "^2.6.7"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"@types/node-fetch": "^2.6.4",
		"eslint": "^8.0.0",
		"nock": "^13.5.5",
		"ts-node": "^10.9.1",
		"typescript": "^5.1.3",
		"vitest": "^3.1.3"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/esm/index.js",
			"require": "./dist/cjs/index.js",
			"default": "./dist/cjs/index.js"
		},
		"./resources/*": {
			"types": "./dist/types/resources/*.d.ts",
			"import": "./dist/esm/resources/*.js",
			"require": "./dist/cjs/resources/*.js",
			"default": "./dist/cjs/resources/*.js"
		}
	}
}
